# Copy to broadcast/.env and fill in. broadcast/.env is ignored by git.
# Volcengine Doubao speech synthesis 2.0 (--engine doubao)

# Required: console > API Key management
TTS_API_KEY=

# Optional: a seed-tts-2.0 voice ID from the console's voice library
# TTS_SPEAKER=zh_female_vv_uranus_bigtts

# Optional: seed-tts-2.0 (default) or seed-icl-2.0 for cloned voices
# TTS_RESOURCE_ID=seed-tts-2.0

# Optional: override the WebSocket endpoint
# TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
